# Copie este arquivo para .env
# Banco local: rode `npm run db:local` num terminal e deixe aberto.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/crm"
# Banco "sombra" que o Prisma usa para conferir migrações (só no desenvolvimento)
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/crm_shadow"
# Conexões simultâneas com o banco.
DATABASE_POOL_MAX=5

# WhatsApp (Evolution API)
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="mesma chave de AUTHENTICATION_API_KEY da Evolution API"
# Só para o seed (Brigada MG). Cada empresa tem a própria conexão, guardada no banco.
EVOLUTION_INSTANCIA="brigada-mg"
WHATSAPP_WEBHOOK_URL="http://localhost:3000/api/whatsapp/webhook"
# Pelo menos 16 caracteres aleatórios: quem souber este segredo pode inventar mensagens recebidas.
WHATSAPP_WEBHOOK_SEGREDO="troque-por-um-texto-aleatorio"

# Nome do produto nas telas públicas (entrar, criar conta) e nos e-mails.
APP_NOME="CRM"
# Endereço público do CRM, usado nos links dos e-mails e da agenda. OBRIGATÓRIO na VPS, com
# https e sem caminho no fim: sem ele, nenhum link é gerado (o CRM nunca usa os cabeçalhos da
# requisição para montar links em produção). No seu computador é opcional.
# APP_URL="https://crm.seudominio.com.br"

# Cabeçalho em que o Caddy escreve o IP de quem acessa (usado nos limites de tentativas).
# Só funciona se o Caddy SEMPRE sobrescrever este cabeçalho e a porta do CRM não estiver
# aberta na internet (docs/DEPLOY-VPS.md). Sem ele, valem só os limites por e-mail e gerais.
# PROXY_IP_HEADER="x-real-ip"

# Primeiro acesso em produção: código de pelo menos 16 caracteres que a tela pede para criar
# o primeiro administrador. Sem ele, o primeiro acesso fica FECHADO. Apague depois de usar.
# Gerar um: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# SETUP_TOKEN=""

# E-mail (SMTP): confirmação de cadastro e "esqueci minha senha".
# Funciona com Brevo, Resend, Amazon SES ou o e-mail do domínio. Sem SMTP_HOST,
# nada sai: no `npm run dev` o e-mail aparece no terminal (bom para testar). Em produção não
# aparece (o terminal guardaria links de acesso): sem SMTP, ninguém recebe convite nem link.
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORTA="587"
# SMTP_USUARIO="usuario-do-smtp"
# SMTP_SENHA="senha-do-smtp"
# EMAIL_REMETENTE="CRM <nao-responda@seudominio.com.br>"
# E-mail do dono do sistema: recebe um aviso a cada empresa nova.
# DONO_EMAIL="voce@seudominio.com.br"

# Cadastro público (página "Criar conta").
# CADASTRO_DIAS_TESTE="14"
# "1" = fecha a página Criar conta (empresas só pelo script scripts/criar-empresa.mts).
# CADASTRO_DESLIGADO="1"

# Tetos por empresa e do servidor (os valores abaixo são os padrões; só preencha para mudar).
# Mensagens que uma empresa AINDA NÃO APROVADA pode começar por dia. Responder quem escreveu
# nas últimas 24 h não conta. Empresa aprovada (campanhasLiberadas) não tem este teto.
# ENVIOS_DIA_NAO_APROVADA="50"
# Mensagens agendadas esperando a hora, por empresa (aprovada / não aprovada).
# AGENDADAS_PENDENTES="5000"
# AGENDADAS_PENDENTES_NAO_APROVADA="200"
# Avisos de webhook esperando na fila, por empresa.
# WEBHOOKS_PENDENTES="2000"
# Usuários ativos + convites valendo, por empresa.
# USUARIOS_POR_EMPRESA="50"
# Espaço para arquivos do WhatsApp por empresa, em MB (aprovada / não aprovada).
# ARQUIVOS_MB_POR_EMPRESA="10240"
# ARQUIVOS_MB_NAO_APROVADA="1024"
# Maior mídia recebida que o CRM guarda, em MB (acima disso entra só a mensagem).
# MIDIA_RECEBIDA_MB="20"
# Números de WhatsApp (instâncias da Evolution API) no servidor todo.
# INSTANCIAS_WHATSAPP="10"

# Só para desenvolver: "1" deixa um webhook apontar para o seu computador (ex.: n8n local).
# Em produção é ignorado, de propósito.
# WEBHOOKS_PERMITIR_LOCAL="1"

# Pasta das fotos, áudios e documentos do WhatsApp (fora do projeto).
# Padrão: ../crm-arquivos
# ARQUIVOS_DIR="/caminho/para/crm-arquivos"

# Testes: "1" = nada sai para o WhatsApp (as mensagens só ficam registradas no CRM).
# Melhor colocar no .env.development.local, que vale só para o npm run dev.
# WHATSAPP_SIMULAR_ENVIO="1"

# "1" = não liga o relógio de mensagens agendadas neste servidor.
# AUTOMACAO_DESLIGADA="1"
