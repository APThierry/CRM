# Copie este arquivo para .env
# Banco local: rode `npm run db:local` num terminal e deixe aberto.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/crm"
# Banco "sombra" que o Prisma usa para conferir migrações (só no desenvolvimento)
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/crm_shadow"
# Conexões simultâneas com o banco.
DATABASE_POOL_MAX=5
