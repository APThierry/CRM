# Copie este arquivo para .env
# Banco local: rode `npm run db:local` num terminal e deixe aberto.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/crm"
# Banco "sombra" que o Prisma usa para conferir migrações (só no desenvolvimento)
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/crm_shadow"
# Conexões simultâneas com o banco.
DATABASE_POOL_MAX=5

# WhatsApp (Evolution API)
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="mesma chave de AUTHENTICATION_API_KEY da Evolution API"
EVOLUTION_INSTANCIA="brigada-mg"
WHATSAPP_WEBHOOK_URL="http://localhost:3000/api/whatsapp/webhook"
WHATSAPP_WEBHOOK_SEGREDO="troque-por-um-texto-aleatorio"

# Pasta das fotos, áudios e documentos do WhatsApp (fora do projeto).
# Padrão: ../crm-arquivos
# ARQUIVOS_DIR="/caminho/para/crm-arquivos"
