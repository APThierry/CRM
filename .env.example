# Copie este arquivo para .env
# Banco local: rode `npm run db:local` num terminal e deixe aberto.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/crm"
# Banco "sombra" que o Prisma usa para conferir migrações (só no desenvolvimento)
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/crm_shadow"
# Conexões simultâneas com o banco.
DATABASE_POOL_MAX=5

# WhatsApp (Evolution API)
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="mesma chave de AUTHENTICATION_API_KEY da Evolution API"
# Só para o seed (Brigada MG). Cada empresa tem a própria conexão, guardada no banco.
EVOLUTION_INSTANCIA="brigada-mg"
WHATSAPP_WEBHOOK_URL="http://localhost:3000/api/whatsapp/webhook"
WHATSAPP_WEBHOOK_SEGREDO="troque-por-um-texto-aleatorio"

# Nome do produto nas telas públicas (entrar, criar conta) e nos e-mails.
APP_NOME="CRM"
# Endereço público do CRM, usado nos links dos e-mails. Na VPS: https://crm.seudominio.com.br
# APP_URL="https://crm.seudominio.com.br"

# E-mail (SMTP): confirmação de cadastro e "esqueci minha senha".
# Funciona com Brevo, Resend, Amazon SES ou o e-mail do domínio. Sem SMTP_HOST,
# nada sai: o e-mail aparece no terminal do `npm run dev` (bom para testar).
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORTA="587"
# SMTP_USUARIO="usuario-do-smtp"
# SMTP_SENHA="senha-do-smtp"
# EMAIL_REMETENTE="CRM <nao-responda@seudominio.com.br>"
# E-mail do dono do sistema: recebe um aviso a cada empresa nova.
# DONO_EMAIL="voce@seudominio.com.br"

# Cadastro público (página "Criar conta").
# CADASTRO_DIAS_TESTE="14"
# "1" = fecha a página Criar conta (empresas só pelo script scripts/criar-empresa.mts).
# CADASTRO_DESLIGADO="1"

# Pasta das fotos, áudios e documentos do WhatsApp (fora do projeto).
# Padrão: ../crm-arquivos
# ARQUIVOS_DIR="/caminho/para/crm-arquivos"

# Testes: "1" = nada sai para o WhatsApp (as mensagens só ficam registradas no CRM).
# Melhor colocar no .env.development.local, que vale só para o npm run dev.
# WHATSAPP_SIMULAR_ENVIO="1"

# "1" = não liga o relógio de mensagens agendadas neste servidor.
# AUTOMACAO_DESLIGADA="1"
